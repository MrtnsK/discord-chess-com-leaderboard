# Token de ton application Discord (obligatoire)
DISCORD_TOKEN=colle_ton_token_ici

# Optionnel : id du serveur pour un sync instantané des commandes (pratique en dev)
# GUILD_ID=123456789012345678

# Optionnel : fuseau horaire pour les heures de maj (défaut: Europe/Paris)
# TZ_NAME=Europe/Paris

# Optionnel : chemin de la base SQLite
# Sur Railway, pointe vers un volume persistant, ex: /data/leaderboard.db
# DB_PATH=leaderboard.db
